# Copy to .env and fill in real values. NEVER commit .env.

# --- Required ---
# Bot token from the Discord Developer Portal (secret).
DISCORD_BOT_TOKEN=dummy-bot-token-replace-me
# Server (guild) ID where slash commands are registered.
DISCORD_GUILD_ID=111111111111111111
# Comma-separated user IDs allowed to operate the bot.
ALLOWED_USER_IDS=222222222222222222
# Channel ID for notifications / posts.
NOTIFY_CHANNEL_ID=333333333333333333
# Used by /news for summarization (secret).
ANTHROPIC_API_KEY=dummy-anthropic-key-replace-me

# --- Optional ---
# User ID that receives failure DMs (default: first ALLOWED_USER_IDS entry).
#ADMIN_USER_ID=222222222222222222
# External heartbeat (dead man's switch) URL, https only (secret).
#BOT_HEARTBEAT_URL=https://example.invalid/ping/dummy
#SUMMARY_MODEL=claude-haiku-5-5
#NEWS_TOTAL_COUNT=10
#NEWS_GENERAL_RATIO=0.5
#NEWS_MAX_AGE_HOURS=36
#LOG_LEVEL=INFO
# SQLite database file (default /data/nomusyo.db; the parent directory must exist).
#DB_PATH=./data/nomusyo.db
# Default IANA time zone for schedules (default Asia/Tokyo).
#TZ_DEFAULT=Asia/Tokyo
# Morning digest time, HH:MM in TZ_DEFAULT (default 06:55).
#DIGEST_TIME=06:55
# Scheduled news post by the bot is NOT implemented yet (V2-70): NEWS_POST_TIME (default 07:00)
# and NEWS_POST_ENABLED (default false) are only read and have no effect. News is still
# posted by the GitHub Actions cron.
#NEWS_POST_TIME=07:00
#NEWS_POST_ENABLED=false
# Read but currently unused: failure notices always go as a DM to ADMIN_USER_ID.
#ADMIN_CHANNEL_ID=333333333333333333
